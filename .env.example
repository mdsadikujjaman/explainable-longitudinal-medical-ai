# ==============================================================================
# Explainable Longitudinal Medical AI — Environment Configuration Template
# Copy this file to .env and configure secrets before running the application.
# IMPORTANT: DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Security: Cryptographically random secret of at least 32 characters for JWT signing.
# Generate on Linux/macOS: openssl rand -hex 32
# Generate in Python: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Environment mode:
# Set to 'production' to enforce strict security checks (fails if JWT_SECRET_KEY is insecure).
# Set to 'development' for local prototyping.
PLATFORM_ENV=development

# Synthetic Demo Mode:
# Set to '1' to enable synthetic demonstration cohort and seeded test accounts.
# Set to '0' for private research / production mode (no default demo accounts created).
DEMO_MODE=1

# SQLite database storage path
PLATFORM_DB_PATH=platform_data.db

# Optional path to private trained model checkpoint (Leave blank for synthetic demo mode)
MODEL_CHECKPOINT_PATH=
